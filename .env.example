# Copy to .env for local Docker Compose use. Never commit real credentials.
POSTGRES_USER=aquant
POSTGRES_PASSWORD=change-me-before-live
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PREFECT_HOST_PORT=4200
MLFLOW_HOST_PORT=5000

# Runtime overrides use AQUANT_ and double underscores for nested keys.
AQUANT_MODE=BACKTEST
AQUANT_LIVE_TRADING__ENABLED=false
AQUANT_LIVE_TRADING__TIER=READ_ONLY

# Data-provider secrets are read by provider factories and never printed.
TUSHARE_TOKEN=
# Official endpoint is https://api.tushare.pro. HTTP is allowed only for a trusted,
# fixed-IP compatible service. Keep ingestion concurrency at one for such services.
TUSHARE_ENDPOINT=https://api.tushare.pro
